# Optional. Without a key the service still works and writes the template summary.
# Get a key in the Claude Console. Calls are billed to your account.
ANTHROPIC_API_KEY=
# Model used for the summary (cheapest and fastest by default).
AI_MODEL=claude-haiku-5-5
# Shared secret between the Node API and this service (set the same value in api/.env).
AI_SERVICE_TOKEN=
