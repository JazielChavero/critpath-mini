# Copy to ../.env (next to docker-compose.yml) and fill in.
# Domain that points to this machine. On EC2 without a domain, use the free
# sslip.io name of the public IP, e.g. 3.14.15.92 -> 3-14-15-92.sslip.io
DOMAIN=localhost
POSTGRES_PASSWORD=
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Optional; without it the summary uses the template.
ANTHROPIC_API_KEY=
