# Local database used by `npm run import`
DATABASE_URL=postgres://postgres:postgres@localhost:5432/critpath
# Disposable database used by the DB tests (all tables are emptied!)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/critpath_test
# Secret used to sign login tokens. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-chars
PORT=3000
# AI summary service (see ai/.env.example)
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
